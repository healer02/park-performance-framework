# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Credentials and local settings
.env
.env.*
!.env.example
config/local.yaml
*api_key*
*credentials*

# Runtime artifacts
cache/
logs/
*.log

# Data: retain only the documented folder placeholders
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated analysis outputs
outputs/*
!outputs/.gitkeep
!outputs/README.md

